# Optional. Selfie analysis uses Gemini first, then OpenAI if Gemini is unset.
# Leave both empty and the quiz still builds a routine in the browser.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional. Tests point these at a local stub. Production should leave them unset.
GEMINI_API_BASE=
OPENAI_API_BASE=

# Optional. Percent of sessions that try the on-device ONNX reader first (0-100).
# Default 0. The reader also needs models/skin_reader/active.json, which is not in git.
DEVICE_READER_PCT=

# Optional. Anonymous photo-free events. Unset -> POST /api/events returns 202 and stores nothing.
DATABASE_URL=

# Optional. Required for /api/dashboard. Unset -> 503. Wrong value -> 401.
DASHBOARD_TOKEN=

# Optional read-only fallback used only by build_catalog.py if the public Store API fails.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
